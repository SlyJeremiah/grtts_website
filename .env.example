# Copy to .env for local development. Never commit the real .env.
# In production these are set as Vercel environment variables.

# --- Core ---------------------------------------------------------------
# Required when DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
LOG_LEVEL=INFO

# Comma-separated. Defaults cover grtts.co.zw, *.vercel.app and localhost.
# ALLOWED_HOSTS=grtts.co.zw,www.grtts.co.zw,.vercel.app,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://grtts.co.zw,https://www.grtts.co.zw

# --- Database -----------------------------------------------------------
# Omit locally to fall back to sqlite3.
DATABASE_URL=

# --- Email --------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GRTTS <noreply@grtts.co.zw>

# Enquiries and applications are delivered here.
CONTACT_RECIPIENT=shanyaslym19@gmail.com
CONTACT_CC=grttsrangers@gmail.com

# Print emails to the console instead of sending them:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Media storage (Backblaze B2) ---------------------------------------
# Only used when DEBUG=False.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=grtts-media
AWS_S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
AWS_S3_REGION_NAME=us-east-005

# Presigned URLs expire and break CDN caching, image SEO and social previews.
# Set to False once the public bucket is made publicly readable.
B2_SIGNED_URLS=True
B2_URL_EXPIRY=3600
