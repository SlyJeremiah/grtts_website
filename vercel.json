{
  "version": 2,
  "buildCommand": "python manage.py migrate --noinput",
  "builds": [
    {
      "src": "grtts_project/wsgi.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.12" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "grtts_project/wsgi.py" }
  ]
}