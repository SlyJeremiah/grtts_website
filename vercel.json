{
  "version": 2,
  "builds": [
    {
      "src": "grtts_project/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12"
      }
    },
    {
      "src": "main/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/main/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "grtts_project/wsgi.py"
    }
  ]
}
